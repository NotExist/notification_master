<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NotificationListenerService 權限 -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- 外部儲存權限 (用於 Debug dump) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 查詢已安裝 App 資訊 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 網路狀態（裝置狀態記錄用） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 振動（持續提醒功能） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 發送通知（Android 13+，持續提醒 heads-up 通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前景服務（持續提醒） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 全螢幕 Intent（持續提醒螢幕鎖定下全螢幕顯示） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 日曆（匯出到日曆功能，預設關閉） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".NotificationMasterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationMaster"
        tools:targetApi="34">

        <!-- 主 Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NotificationMaster.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.notificationmaster.action.SHOW_DETAIL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Audible Shortcut Activity (Dialog 風格) -->
        <activity
            android:name=".ui.shortcut.AudibleShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.NotificationMaster.Dialog">
            <intent-filter>
                <action android:name="com.notificationmaster.action.SHORTCUT_AUDIBLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Heads-up Shortcut Activity (BottomSheet 風格) -->
        <activity
            android:name=".ui.shortcut.HeadsupShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.NotificationMaster.Transparent">
            <intent-filter>
                <action android:name="com.notificationmaster.action.SHORTCUT_HEADSUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Dismissed Shortcut Activity (BottomSheet 風格) -->
        <activity
            android:name=".ui.shortcut.DismissedShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.NotificationMaster.Transparent">
            <intent-filter>
                <action android:name="com.notificationmaster.action.SHORTCUT_DISMISSED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 外部文字搜尋：選字選單 (API 23+) -->
        <activity-alias
            android:name=".ProcessTextAlias"
            android:targetActivity=".ui.main.MainActivity"
            android:label="@string/process_text_label"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 外部文字搜尋：分享選單 -->
        <activity-alias
            android:name=".ShareTextAlias"
            android:targetActivity=".ui.main.MainActivity"
            android:label="@string/share_text_label"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 持續提醒全螢幕 Activity -->
        <activity
            android:name=".ui.alert.PersistentAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.NotificationMaster.FullScreenAlert" />

        <!-- Widget 設定 Activity（透明 host，所有 UI 走 MaterialAlertDialog/BottomSheet） -->
        <activity
            android:name=".ui.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.NotificationMaster.Transparent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 清單式 Widget -->
        <receiver
            android:name=".ui.widget.NotificationWidgetProvider"
            android:label="@string/widget_list_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notification_widget_list_info" />
        </receiver>

        <!-- 單項式 Widget -->
        <receiver
            android:name=".ui.widget.NotificationSingleWidgetProvider"
            android:label="@string/widget_single_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notification_widget_single_info" />
        </receiver>

        <!-- Widget RemoteViews 資料服務 -->
        <service
            android:name=".ui.widget.NotificationRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- NotificationListenerService -->
        <service
            android:name=".service.NotificationCaptureService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- NLS 保活前景服務 -->
        <service
            android:name=".service.NlsKeepaliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep process alive to prevent NotificationListenerService disconnection" />
        </service>

        <!-- 持續提醒前景服務 -->
        <service
            android:name=".core.alert.PersistentAlertService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm-like persistent alert with ringtone and vibration" />
        </service>

        <!-- 持續提醒停止 Receiver（向下相容） -->
        <receiver
            android:name=".core.alert.AlertStopReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notificationmaster.action.STOP_ALERT_SERVICE" />
            </intent-filter>
        </receiver>

        <!-- FileProvider 用於分享匯出檔案 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
