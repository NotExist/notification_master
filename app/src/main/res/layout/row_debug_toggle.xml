<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/toggle_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- W23g：此 layout 被動態 inflate 多列，所有 Switch 共用同一 ID。
         view state save/restore 以 ID 為 key，同 ID 互相覆寫 → 還原時全部
         被設成樹序最後一列的狀態，且 listener 會把錯值持久化進 prefs。
         狀態以 SharedPreferences 為 SSOT（每次進頁重讀），關閉 view state 保存。 -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/toggle_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:saveEnabled="false" />

</LinearLayout>
